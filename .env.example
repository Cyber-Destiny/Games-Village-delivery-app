# ── Database ────────────────────────────────────────────────
# Any Postgres works. Free option: https://neon.tech (use the "pooled" connection string).
DATABASE_URL=postgres://postgres@localhost:5432/runam

# ── App ─────────────────────────────────────────────────────
# Public URL of the app (used for Paystack callbacks). No trailing slash.
APP_URL=http://localhost:3000
# Long random string used to sign login sessions. Generate one with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string
# Comma-separated emails that become admins when they sign in.
ADMIN_EMAILS=admin@example.com

# ── Paystack ────────────────────────────────────────────────
# Leave empty to run in demo mode (fake checkout + simulated transfers).
# Use sk_test_... while testing, sk_live_... when you launch.
PAYSTACK_SECRET_KEY=
# "off" for a Starter (unregistered) Paystack business, which can't send transfers:
# account names are typed in and payouts are paid from your bank app, then marked paid.
PAYSTACK_TRANSFERS=on
# Domain used to build an email for customers who haven't added one (Paystack requires an email).
PAYSTACK_EMAIL_DOMAIN=customers.runam.ng

# ── Email (sign-in codes) ───────────────────────────────────
# Resend API key (https://resend.com). Empty = codes are printed to the server log.
RESEND_API_KEY=
# Sender, on a domain verified in Resend. Defaults to codes@<APP_URL host>.
EMAIL_FROM="Runam <codes@runam.app>"

# ── SMS (optional errand alerts) ────────────────────────────
# "console" prints messages to the server log. "termii" sends real SMS.
SMS_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER_ID=Runam
# Termii channel: "dnd" delivers to DND numbers (needs approved sender ID), "generic" otherwise.
TERMII_CHANNEL=dnd

# LOCAL DEMO ONLY: shows login codes on screen (until Resend is set up) and uses a
# pretend checkout (until Paystack is set up). Anyone could sign in as anyone, so
# never set this on the live site. Without it, codes go only by email and payments
# only through Paystack.
DEMO_MODE=false

# ── Web push (optional) ─────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com

# Your registered business name, shown in the Terms and Privacy Policy (defaults to the app name)
NEXT_PUBLIC_LEGAL_NAME=

# In-app calls work peer-to-peer. For reliable calls on mobile data, add a TURN relay
# (e.g. Cloudflare Realtime TURN or Metered). Comma-separate several URLs.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
